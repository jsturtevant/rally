{
  "name": "squad-rally",
  "version": "0.2.0",
  "description": "CLI tool that dispatches Squad teams to GitHub issues and PR reviews via git worktrees",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsturtevant/rally.git"
  },
  "bin": {
    "rally": "./bin/rally.js"
  },
  "scripts": {
    "test": "GIT_TERMINAL_PROMPT=0 node test/build-jsx.mjs && node --test ./test/*.test.js && node --test --test-force-exit ./test/ui/*.test.js",
    "test:e2e": "GIT_TERMINAL_PROMPT=0 node test/build-jsx.mjs && RALLY_E2E_TAGS_EXCLUDE='slow' npm run test:e2e:run",
    "test:e2e:fast": "GIT_TERMINAL_PROMPT=0 node test/build-jsx.mjs && RALLY_E2E_FILE_EXCLUDE='^dispatch/' npm run test:e2e:run",
    "test:e2e:dispatch": "GIT_TERMINAL_PROMPT=0 node test/build-jsx.mjs && RALLY_E2E_TAGS='slow' npm run test:e2e:run",
    "test:e2e:run": "mm test/e2e/cli --state-dir-env RALLY_HOME --env-prefix RALLY_E2E_",
    "test:e2e:install": "bash scripts/install-markmason.sh",
    "test:all": "npm test && npm run test:e2e",
    "test:e2e:pty": "GIT_TERMINAL_PROMPT=0 node test/build-jsx.mjs && GIT_TERMINAL_PROMPT=0 node --test --test-force-exit --test-timeout 120000 './test/e2e/cli/*.test.js' './test/e2e/journeys/**/*.test.js'",
    "docs:generate": "node scripts/generate-docs.js"
  },
  "dependencies": {
    "@bradygaster/squad-sdk": "^0.12.0",
    "@inquirer/prompts": "^8.4.2",
    "@opentelemetry/api": "^1.9.1",
    "chalk": "^5.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-table": "^3.1.0",
    "js-yaml": "^5.3.0",
    "ora": "^9.4.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@xterm/headless": "^6.0.0",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
